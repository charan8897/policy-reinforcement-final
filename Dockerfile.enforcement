FROM python:3.10-slim

WORKDIR /app

# Install dependencies
RUN apt-get update && apt-get install -y curl && rm -rf /var/lib/apt/lists/*

# Copy requirements
COPY requirements-enforcement.txt .

# Install Python packages
RUN pip install --no-cache-dir -r requirements-enforcement.txt

# Copy application
COPY stage11_enforcement_api.py .
COPY opa_bundles ./opa_bundles

# Create logs directory
RUN mkdir -p ./logs

# Health check
HEALTHCHECK --interval=5s --timeout=3s --retries=5 --start-period=10s \
    CMD curl -f http://localhost:8000/health || exit 1

# Run API
CMD ["uvicorn", "stage11_enforcement_api:app", "--host", "0.0.0.0", "--port", "8000"]
